  "dependencies": {
    "axios": "^1.13.6",
    "bcryptjs": "^2.4.3",
    "dotenv": "^16.3.1",
    "ioredis": "^5.10.1",
    "jsonwebtoken": "^9.0.0",
    "nodemailer": "^8.0.2",
    "winston": "^3.19.0"
  }
}
