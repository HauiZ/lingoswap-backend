# .env.example - Template biến môi trường
# Sao chép file này thành .env và điền thông tin thực tế

# Server
PORT=5000
NODE_ENV=development

# Database
DB_URI=mongodb://localhost:27017/lingoswap
# Hoặc với MongoDB Atlas:
# DB_URI=mongodb+srv://username:password@cluster.mongodb.net/lingoswap

# JWT Authentication
JWT_SECRET=your-super-secret-key-change-this-in-production
JWT_EXPIRE=7d

# Logging
LOG_LEVEL=debug
